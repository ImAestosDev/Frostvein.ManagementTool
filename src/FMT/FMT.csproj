<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FMT</AssemblyName>
    <RootNamespace>Fmt.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\fmt.ico</ApplicationIcon>
    <Version>1.0.6</Version>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\fmt.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\items.tsv" Condition="Exists('Assets\items.tsv')" />
    <Resource Include="Assets\icons.zip" Condition="Exists('Assets\icons.zip')" />
    <Resource Include="Assets\cards.tsv" Condition="Exists('Assets\cards.tsv')" />
    <Resource Include="Assets\monsters.tsv" Condition="Exists('Assets\monsters.tsv')" />
    <ProjectReference Include="..\Fmt.Core\Fmt.Core.csproj" />
  </ItemGroup>
</Project>
